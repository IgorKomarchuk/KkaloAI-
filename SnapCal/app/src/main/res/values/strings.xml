    <!-- Privacy policy -->
    <string name="pp_title_bar">Privacy Policy</string>
    <string name="pp_heading">Privacy &amp; Security</string>
    <string name="pp_updated">Last updated: April 19, 2026</string>
    <string name="pp_s1_title">1. AI Analysis &amp; Photos</string>
    <string name="pp_s1_body">KkaloAI uses Google Gemini and Groq (Meta Llama) AI to analyze food photos. Photos are processed in real-time and are NOT stored on our servers. They are discarded immediately after the nutritional breakdown is generated.</string>
    <string name="pp_s2_title">2. Health Connect Integration</string>
    <string name="pp_s2_body">If enabled, nutrition data (calories, protein, fats, carbs) is shared with Android Health Connect. This integration is optional and follows Google\'s Health Connect permissions policy.</string>
    <string name="pp_s3_title">3. Nutritional Coaching &amp; GLP-1</string>
    <string name="pp_s3_body">Symptom tracking and meal trends are processed locally to provide AI Coaching. We do not share your health markers or medication status with third parties.</string>
    <string name="pp_s4_title">4. Data Security</string>
    <string name="pp_s4_body">We use end-to-end TLS encryption for data transmission. We prioritize keeping your diary private and stored on your device.</string>
    <string name="pp_s5_title">5. Your Rights (GDPR/CCPA)</string>
    <string name="pp_s5_body">You have the right to access, export, or delete your data. You can delete your history from the settings at any time.</string>
    <string name="pp_s6_title">6. Contact</string>
    <string name="pp_s6_body">For privacy inquiries, contact us at: isktrend@gmail.com</string>
</resources>
