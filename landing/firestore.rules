rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read/write their own user document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Authenticated users can read/write referral codes 
    // (Used for checking if a code exists and registering a new one)
    match /referralCodes/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Each user can only read/write their own meals subcollection
    match /users/{userId}/meals/{mealId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
